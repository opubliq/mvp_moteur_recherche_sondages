{
  "name": "opubliq-sondages-functions",
  "version": "0.1.0",
  "private": true,
  "main": "dist/azure-functions/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && func start",
    "test": "vitest run",
    "create-trial-account": "npm run build && node dist/azure-functions/src/scripts/create-trial-account.js",
    "create-client-account": "npm run build && node dist/azure-functions/src/scripts/create-client-account.js"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.5.1",
    "@azure/storage-blob": "^12.33.0",
    "@duckdb/node-api": "^1.5.4-r.1",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
