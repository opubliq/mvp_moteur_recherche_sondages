# Azure AI Search
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_ADMIN_KEY=<search-admin-key>
SEARCH_QUERY_KEY=<search-query-key>

# Azure OpenAI (embeddings & chat)
AOAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AOAI_KEY=<aoai-key>
AOAI_EMBED_DEPLOYMENT=text-embedding-3-large
AOAI_CHAT_DEPLOYMENT=gpt-4o

# Cohere Rerank v4.0 pro (Azure AI Foundry) — rerank sémantique de /search.
# REQUIS : /search renvoie 500 sur toute recherche si l'une manque.
# Ressource Foundry distincte, en eastus2 (seule région offrant v4.0 pro) —
# le reste de l'infra est en canadaeast.
COHERE_RERANK_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
COHERE_RERANK_DEPLOYMENT=Cohere-rerank-v4.0-pro
COHERE_RERANK_KEY=<cohere-rerank-key>

# Mistral-Large-3 (Azure AI Foundry) — décomposition de requête (query expansion).
# Vars dédiées, distinctes de COHERE_RERANK_* : même ressource Foundry possible,
# mais un déploiement différent — nommer via COHERE_* serait trompeur.
# Route compatible OpenAI Chat Completions, auth Bearer, temperature: 0.
FOUNDRY_CHAT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
FOUNDRY_CHAT_DEPLOYMENT=Mistral-Large-3
FOUNDRY_CHAT_KEY=<foundry-chat-key>

# Azure Blob Storage — microdonnées répondant (Parquet, epic v33).
# Container privé (aucun accès public anonyme) : la clé est SERVEUR uniquement
# (ingestion + Netlify Function), jamais exposée côté client.
# Convention de nommage : survey-responses/{survey_id}.parquet + _manifest.json.
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_STORAGE_KEY=<storage-account-key>
AZURE_STORAGE_CONTAINER=survey-responses

# Comptes utilisateurs (f3i.19) — mêmes AZURE_STORAGE_ACCOUNT/KEY ci-dessus,
# tables Users/Sessions dans le service Table du même compte (pas de nouvelle
# ressource). PASSWORD_PEPPER est optionnel (défense en profondeur sur le hash
# bcrypt) : générer via `openssl rand -hex 32`.
PASSWORD_PEPPER=<random-hex-string>

# Frontend (Vite, build-time — cf. src/api.ts) : base des endpoints API.
# Vide/absente = chemins RELATIFS, same-origin (comportement historique
# Netlify — frontend et functions sur le même domaine). À renseigner UNIQUEMENT
# si frontend et Azure Functions sont hébergés sur des domaines distincts
# (f3i.1/f3i.2/b1d) — pas de secret, cette valeur finit dans le bundle JS public.
VITE_API_BASE_URL=https://opubliq-sondages-functions.azurewebsites.net
