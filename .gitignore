# Données : symlink vers le dossier Google Drive partagé (hors repo)
/data

# Outillage local (suivi d'enjeux Beads) — non versionné
.beads/
AGENTS.md

eval/

# Exports Google Docs locaux (HTML + assets) dans pricing/ — la doc source
# (.md) est versionnée, mais pas ces artefacts d'export.
pricing/*.html
pricing/*_files/

# Secrets / env
*.env
aws_keys.env

# Python
.venv*/
__pycache__/
*.py[cod]

# Node
node_modules/

# Vite build output
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Bases locales
*.sqlite
*.db
*.npy

# OS / éditeurs
.DS_Store
*.log

# Local Netlify folder
.netlify

# Azure Functions Core Tools — secrets locaux (garder local.settings.json.example versionné)
azure-functions/local.settings.json

# Bundles de fonctions pré-packagés (ne jamais committer : ils shadowent le .ts)
netlify/functions/*.zip

# Worktrees éphémères créés par Claude Code
.claude/worktrees/
